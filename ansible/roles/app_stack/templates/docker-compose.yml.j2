---
services:
  nginx:
    image: "{{ app_stack_nginx_image }}"
    restart: "{{ app_stack_restart_policy }}"
    depends_on:
      app:
        condition: service_healthy
    ports:
      - "80:80"
    volumes:
      - type: bind
        source: "{{ app_stack_path }}/nginx.conf"
        target: /etc/nginx/conf.d/default.conf
        read_only: true
        bind:
          create_host_path: false
    networks:
      - app_network

  app:
    image: "{{ app_stack_image }}"
    restart: "{{ app_stack_restart_policy }}"
    expose:
      - "{{ app_stack_internal_port }}"
    env_file:
      - .env
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - >-
          import urllib.request;
          urllib.request.urlopen('http://127.0.0.1:{{ app_stack_internal_port }}{{ app_stack_health_path }}',
          timeout={{ app_stack_health_timeout_seconds }}).close()
      interval: "{{ app_stack_health_interval }}"
      timeout: "{{ app_stack_health_timeout }}"
      start_period: "{{ app_stack_health_start_period }}"
      retries: {{ app_stack_health_retries }}
    networks:
      - app_network

networks:
  app_network:
    driver: bridge