---
services:
  nginx:
    image: "{{ nginx_image }}"
    restart: "{{ app_restart_policy }}"
    depends_on:
      app:
        condition: service_healthy
    ports:
      - "80:80"
    volumes:
      - type: bind
        source: "{{ app_stack_path }}/nginx.conf"
        target: /etc/nginx/conf.d/default.conf
        read_only: true
        bind:
          create_host_path: false
    networks:
      - app_network

  app:
    image: "{{ app_image }}"
    restart: "{{ app_restart_policy }}"
    expose:
      - "{{ app_internal_port }}"
    environment:
      DB_HOST: "{{ db_private_ip }}"
      DB_PORT: "{{ db_port }}"
      DB_NAME: "{{ db_name }}"
      DB_USER: "{{ db_app_user }}"
      DB_PASSWORD: "{{ vault_pg_app_password }}"
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - >-
          import urllib.request;
          urllib.request.urlopen('http://127.0.0.1:{{ app_internal_port }}{{ app_health_path }}',
          timeout={{ app_health_timeout_seconds }}).close()
      interval: "{{ app_health_interval }}"
      timeout: "{{ app_health_timeout }}"
      start_period: "{{ app_health_start_period }}"
      retries: {{ app_health_retries }}
    networks:
      - app_network

networks:
  app_network:
    driver: bridge